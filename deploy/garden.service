[Unit]
Description=Garden monitor
# Start only once the clock is right, or readings get wrong timestamps (docs/adr/0001-wait-for-clock-sync.md).
Wants=time-sync.target
After=time-sync.target network-online.target

[Service]
User=garden
Group=garden
WorkingDirectory=/opt/garden
# GARDEN_ADMINS lives here, on the Pi only, because the repo is public (docs/adr/0003-admins-by-tailscale-identity.md).
EnvironmentFile=-/etc/garden.env
ExecStart=/opt/garden/garden
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
